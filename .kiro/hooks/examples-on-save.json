{
  "version": "v1",
  "hooks": [
    {
      "name": "examples-on-save",
      "trigger": "PostFileSave",
      "action": {
        "type": "command",
        "command": "node scripts/examples-on-save.mjs"
      },
      "matcher": "examples[\\\\/][^\\\\/]+[\\\\/](buggy|fixed)[\\\\/][^\\\\/]+\\.ino$",
      "timeout": 600,
      "enabled": true
    }
  ]
}
