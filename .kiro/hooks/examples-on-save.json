{
  "version": "v1",
  "hooks": [
    {
      "name": "examples-on-save",
      "trigger": "PostFileSave",
      "action": {
        "type": "command",
        "command": "cmd /c \"node scripts/build-examples.mjs && npx vitest --run tests/examples\""
      },
      "matcher": "examples[\\\\/][^\\\\/]+[\\\\/](buggy|fixed)[\\\\/][^\\\\/]+\\.ino$",
      "timeout": 600,
      "enabled": true
    }
  ]
}
