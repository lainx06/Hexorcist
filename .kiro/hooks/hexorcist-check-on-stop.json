{
  "version": "v1",
  "hooks": [
    {
      "name": "Hexorcist check on stop",
      "trigger": "Stop",
      "action": {
        "type": "command",
        "command": "npx tsx --no-deprecation cli/hook-stop.ts exorcism-demo/check.json --block"
      },
      "description": "Builds and checks the demo sketch when the agent finishes.",
      "timeout": 300,
      "enabled": true
    }
  ]
}
