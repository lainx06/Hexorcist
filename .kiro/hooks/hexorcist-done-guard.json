{
  "version": "v1",
  "hooks": [
    {
      "name": "Hexorcist done-guard",
      "trigger": "PreToolUse",
      "action": {
        "type": "command",
        "command": "npx tsx --no-deprecation cli/hook-guard.ts exorcism-demo/loop-check.json"
      },
      "description": "Blocks marking a task done until the check says HELD.",
      "matcher": "spec",
      "enabled": true
    }
  ]
}
