{
  "mcpServers": {
    "hexorcist": {
      "command": "node",
      "args": [
        "-e",
        "const fs=require('fs'),path=require('path'),os=require('os'),cp=require('child_process');const cwd=process.cwd();const root=process.env.HEXORCIST_ROOT?path.resolve(process.env.HEXORCIST_ROOT):cwd;function fail(m){try{fs.appendFileSync(path.join(os.tmpdir(),'hexorcist-launcher.log'),m+os.EOL)}catch(e){}process.exit(1)}const entry=path.join(root,'mcp','bin.ts');let tsx=path.join(root,'node_modules','tsx','dist','cli.mjs');if(!fs.existsSync(tsx)){try{const pj=path.join(root,'node_modules','tsx','package.json');const b=JSON.parse(fs.readFileSync(pj,'utf8')).bin;const rel=typeof b==='string'?b:b&&b.tsx;if(rel)tsx=path.join(path.dirname(pj),rel)}catch(e){}}if(!fs.existsSync(entry))fail('missing '+entry);if(!fs.existsSync(tsx))fail('missing '+tsx);const env=Object.assign({},process.env,{INIT_CWD:process.env.INIT_CWD||cwd});const child=cp.spawn(process.execPath,[tsx,'--no-deprecation',entry],{cwd:root,stdio:'inherit',env});child.on('error',function(e){fail('start failed: '+e.message)});child.on('exit',function(c){process.exit(c===null?1:c)});"
      ]
    }
  }
}
